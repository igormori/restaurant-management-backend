{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=restaurant_db;Username=postgres;Password=postgres",
    "//": "In production, inject 'ConnectionStrings:DefaultConnection' via Environment Variable"
  },
  "AllowedHosts": "*",
  "Sentry": {
    "Dsn": "",
    "//": "Empty disables Sentry. In production, inject 'Sentry:Dsn' via Environment Variable"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Key": "your-super-secret-key-at-least-32-characters-long-for-development",
    "//": "In production, inject 'Jwt:Key' via Environment Variable or Secret Manager",
    "Issuer": "RestaurantManagement",
    "Audience": "RestaurantManagement",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 30
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "VerificationCodeExpiryMinutes": 15,
    "ResendCooldownSeconds": 60,
    "MaxVerificationAttempts": 5,
    "VerificationLockoutDurationMinutes": 15
  },
  "AuthRateLimit": {
    "Login": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Register": { "PermitLimit": 5, "WindowSeconds": 3600 },
    "ResendVerification": { "PermitLimit": 3, "WindowSeconds": 600 },
    "Verify": { "PermitLimit": 10, "WindowSeconds": 600 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 },
    "TrustedProxies": []
  },
  "Email": {
    "SmtpHost": "sandbox.smtp.mailtrap.io",
    "SmtpPort": 2525,
    "SmtpUser": "",
    "SmtpPass": "",
    "FromEmail": "no-reply@restaurant.com",
    "FromName": "Restaurant Management",
    "EnableSsl": false
  }
}